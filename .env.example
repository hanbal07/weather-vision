# WeatherVision configuration
# ---------------------------------------------------------------
# The default weather provider (Open-Meteo) is FREE and does NOT
# require an API key. You can run the app with an empty value.
#
# Copy this file to `.env` for local development:
#   copy .env.example .env     (Windows)
#   cp .env.example .env       (macOS / Linux)
#
# IMPORTANT: never commit the real `.env` file. It is ignored by git.
# On the deployment platform, set these as environment variables / secrets
# instead of committing them.

# Optional key if you later swap to a key-based weather provider.
# NEVER put a real key here — only in `.env` locally or in the hosting
# platform's secret store.
WEATHER_API_KEY=

# Optional default theme on first launch: "dark" or "light"
APP_THEME=dark

# Set to 1 to start in Demo Mode (realistic mock data, no internet needed).
DEMO_MODE=0

# Web deployment
# ------------------------------------------------------------------
# Port the server should bind to (set automatically by the hosting
# platform, e.g. Railway / Render provide a PORT variable).
PORT=8000

# Override the SQLite database location (e.g. a mounted volume path).
# Defaults to ./data/weathervision.db
# DATABASE_PATH=/data/weathervision.db

# Set to 1 to run the Flask development server in debug mode.
# Never enable this in production.
FLASK_DEBUG=0
